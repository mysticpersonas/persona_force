# /trader/event RSVP backend (api/trader-rsvp.js)
# Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# GoHighLevel: Automation > Workflows > trigger "Inbound Webhook" > copy URL
GHL_RSVP_WEBHOOK_URL=

# Upstash Redis (Vercel Marketplace "Upstash for Redis", formerly Vercel KV).
# Connecting the store to the project injects these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
